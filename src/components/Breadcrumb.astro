---
import { href } from '../utils/paths';
interface Props { stageId: string; stageName: string; projectName: string; }
const { stageId, stageName, projectName } = Astro.props;
---

<nav class="crumbs" aria-label="面包屑">
  <ol>
    <li><a href={href(`timeline/#timeline-stage-${stageId}`)}>实践脉络</a></li>
    <li><a href={href(`projects/#stage-${stageId}`)}>{stageName}</a></li>
    <li aria-current="page">{projectName}</li>
  </ol>
</nav>

<style>
  .crumbs { font-family: var(--font-label); font-size: var(--text-xs); color: var(--muted-on-ink); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .crumbs li:not(:last-child)::after { content: '›'; margin-left: var(--space-2); }
  .crumbs a { text-decoration: underline; text-underline-offset: 3px; }
</style>
