---
interface Props {
  title: string;
  note?: string;
}
const { title, note } = Astro.props;
---

<div class="empty-state" role="status">
  <p class="empty-state__title">{title}</p>
  {note && <p>{note}</p>}
</div>

<style>
  .empty-state { padding: var(--space-5); border: 1px dashed currentColor; color: var(--muted-on-paper); }
  .tone-ink .empty-state { color: var(--muted-on-ink); }
  .empty-state__title { color: inherit; font-family: var(--font-label); letter-spacing: .08em; }
  .empty-state p + p { margin-top: var(--space-2); font-size: var(--text-sm); }
</style>
