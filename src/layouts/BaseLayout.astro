---
/**
 * 基础布局：语义骨架 + 字体 + 视图转场 + 全站脚本。
 */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.name,
  description = '“七彩云南·铁脉同行”高校社会实践成果展示：三个实践阶段、六个实践项目的影像展。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@700;900&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script src="../scripts/site.js"></script>
  </body>
</html>
