---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import Lightbox from '../components/Lightbox.astro';
import { stages } from '../data/stages';
import { projects } from '../data/projects';
import { media } from '../data/media';
import { href } from '../utils/paths';
const visibleMedia = media.filter((item) => item.verified);
const projectGroups = projects
  .map((project) => ({ project, items: visibleMedia.filter((item) => item.project === project.slug) }))
  .filter(({ items }) => items.length > 0);
const mediaParts = [
  { type: 'video' as const, label: '微课视频', eyebrow: 'PART 01 · VIDEO' },
  { type: 'image' as const, label: '纪实照片', eyebrow: 'PART 02 · PHOTO' },
];
---

<BaseLayout title="影像档案 · 七彩云南·铁脉同行">
  <main id="main" class="archive-page tone-paper">
    <header class="page-intro container"><p class="eyebrow">ARCHIVE · 媒体登记</p><h1>影像档案</h1><p class="reading">影像成果按所属项目归档，并在项目内分为微课视频与纪实照片。仅呈现完成授权、隐私与元数据核验的媒体。</p></header>
    <section class="archive-tools container" aria-labelledby="filter-title"><div class="section-head"><p class="eyebrow">FILTER</p><h2 id="filter-title">筛选档案</h2></div>
      <div class="filter-groups">
        <fieldset><legend>阶段</legend><button type="button" aria-pressed="true" data-filter-stage="all">全部</button>{stages.map((stage) => <button type="button" aria-pressed="false" data-filter-stage={stage.id}>{stage.name}</button>)}</fieldset>
        <fieldset><legend>项目</legend><button type="button" aria-pressed="true" data-filter-project="all">全部</button>{projects.map((project) => <button type="button" aria-pressed="false" data-filter-project={project.slug}>{project.shortName}</button>)}</fieldset>
        <fieldset><legend>媒介类型</legend><button type="button" aria-pressed="true" data-filter-type="all">全部</button><button type="button" aria-pressed="false" data-filter-type="image">图片</button><button type="button" aria-pressed="false" data-filter-type="video">视频</button></fieldset>
      </div><button class="filter-reset" type="button" data-filter-reset>重置筛选</button>
    </section>
    <section class="archive-results container" aria-live="polite">
      {visibleMedia.length === 0 ? <EmptyState title="档案室待媒体登记后开放" note="当前没有完成公开核验的图片或视频。筛选界面保留用于后续媒体登记。" /> : (
        <div class="archive-projects">
          {projectGroups.map(({ project, items }, projectIndex) => (
            <article class="archive-project" data-archive-project style={`--project-color: ${project.color.base};`}>
              <header class="archive-project__head">
                <p class="eyebrow">PROJECT {String(projectIndex + 1).padStart(2, '0')} · 项目影像成果</p>
                <h2>{project.name}</h2>
              </header>
              {mediaParts.map((part) => {
                const partItems = items.filter((item) => item.type === part.type);
                return partItems.length > 0 && (
                  <section class="archive-part" data-archive-part aria-labelledby={`${project.slug}-${part.type}-title`}>
                    <header class="archive-part__head">
                      <p class="eyebrow">{part.eyebrow}</p>
                      <h3 id={`${project.slug}-${part.type}-title`}>{part.label}</h3>
                    </header>
                    <div class="archive-grid" data-archive-grid data-lightbox-group={`${project.slug}-${part.type}`}>
                      {partItems.map((item) => item.type === 'image' ? <button type="button" data-archive-item data-stage={item.stage} data-project={item.project} data-type={item.type} data-lightbox data-src={href(item.src)} data-alt={item.alt} data-caption={item.caption ?? item.alt}><img src={href(item.src)} alt={item.alt} width={item.width} height={item.height} loading="lazy" /></button> : <video data-archive-item data-stage={item.stage} data-project={item.project} data-type={item.type} controls playsinline preload="metadata" poster={item.poster ? href(item.poster) : undefined} width={item.width} height={item.height} aria-label={item.alt}><source src={href(item.src)} type="video/mp4" /></video>)}
                    </div>
                  </section>
                );
              })}
            </article>
          ))}
        </div>
      )}
      <div data-filter-empty hidden><EmptyState title="当前筛选无结果" note="请调整筛选条件或重置筛选。" /></div>
    </section>
    {visibleMedia.some((item) => item.type === 'image') && <Lightbox />}
  </main>
</BaseLayout>

<script>
  const initArchive = () => {
    const root = document.querySelector('.archive-tools');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = 'true';
    const state = { stage: 'all', project: 'all', type: 'all' };
    const apply = () => {
      const items = [...document.querySelectorAll('[data-archive-item]')]; let count = 0;
      items.forEach((item) => { const show = ['stage','project','type'].every((key) => state[key] === 'all' || item.dataset[key] === state[key]); item.hidden = !show; if (show) count += 1; });
      document.querySelectorAll('[data-archive-part]').forEach((part) => { part.hidden = !part.querySelector('[data-archive-item]:not([hidden])'); });
      document.querySelectorAll('[data-archive-project]').forEach((projectGroup) => { projectGroup.hidden = !projectGroup.querySelector('[data-archive-item]:not([hidden])'); });
      const empty = document.querySelector('[data-filter-empty]'); if (empty) empty.hidden = items.length === 0 || count > 0;
    };
    root.querySelectorAll('[data-filter-stage],[data-filter-project],[data-filter-type]').forEach((button) => button.addEventListener('click', () => { const key = button.hasAttribute('data-filter-stage') ? 'stage' : button.hasAttribute('data-filter-project') ? 'project' : 'type'; state[key] = button.dataset[`filter${key[0].toUpperCase()}${key.slice(1)}`]; root.querySelectorAll(`[data-filter-${key}]`).forEach((peer) => peer.setAttribute('aria-pressed', String(peer === button))); apply(); }));
    root.querySelector('[data-filter-reset]')?.addEventListener('click', () => { Object.keys(state).forEach((key) => state[key] = 'all'); root.querySelectorAll('[data-filter-stage],[data-filter-project],[data-filter-type]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filterStage === 'all' || button.dataset.filterProject === 'all' || button.dataset.filterType === 'all'))); apply(); });
  };
  initArchive(); document.addEventListener('astro:page-load', initArchive);
</script>

<style>
  .archive-page { padding: 4rem 0 var(--space-9); min-height: 100vh; }
  .page-intro { padding-block: var(--space-9) var(--space-7); display: grid; gap: var(--space-4); }
  .page-intro h1 { font-size: var(--text-hero); } .page-intro > p:last-child { color: var(--muted-on-paper); }
  .archive-tools { padding-block: var(--space-6); border-block: 1px solid var(--hairline-on-paper); }
  .filter-groups { display: grid; gap: var(--space-5); }
  fieldset { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; border: 0; }
  legend { width: 100%; margin-bottom: var(--space-2); font: var(--text-xs) var(--font-label); color: var(--muted-on-paper); }
  button { min-height: 44px; padding: var(--space-2) var(--space-4); border: 1px solid var(--hairline-on-paper); background: transparent; color: inherit; cursor: pointer; }
  button[aria-pressed='true'] { background: var(--text-on-paper); color: var(--paper); }
  .filter-reset { margin-top: var(--space-5); text-decoration: underline; text-underline-offset: 3px; }
  .archive-results { padding-top: var(--space-7); }
  .archive-projects { display: grid; gap: var(--space-9); }
  .archive-project { display: grid; gap: var(--space-7); min-width: 0; }
  .archive-project__head { display: grid; gap: var(--space-3); padding-top: var(--space-5); border-top: 3px solid var(--project-color); }
  .archive-project__head h2 { font-size: var(--text-2xl); }
  .archive-part { display: grid; gap: var(--space-5); min-width: 0; }
  .archive-part__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--space-2) var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid var(--hairline-on-paper); }
  .archive-part__head .eyebrow { grid-column: 1 / -1; }
  .archive-part__head h3 { font-size: var(--text-xl); }
  .archive-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); align-items: start; }
  .archive-grid > * { width: 100%; min-width: 0; max-width: 100%; }
  .archive-grid img { display: block; width: 100%; max-width: 100%; height: auto; object-fit: contain; }
  .archive-grid video { display: block; width: 100%; max-width: 100%; height: auto; max-height: 70svh; background: #000; object-fit: contain; }
  @media (max-width: 48rem) { .archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 30rem) { .archive-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
